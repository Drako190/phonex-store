# ╔══════════════════════════════════════════════════╗
# ║     PhoneX Store — Variables de Entorno          ║
# ║  Copia este archivo como .env y llena los datos  ║
# ╚══════════════════════════════════════════════════╝

# ── SERVIDOR ──────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MONGODB ───────────────────────────────────────
# Pega aquí tu cadena de conexión de MongoDB Atlas o local
# Ejemplo Atlas:  mongodb+srv://USUARIO:CONTRASEÑA@cluster0.xxxxx.mongodb.net/phonex_store
# Ejemplo Local:  mongodb://localhost:27017/phonex_store
MONGODB_URI=mongodb://localhost:27017/phonex_store

# ── JWT (Tokens de sesión) ─────────────────────────
# Pon cualquier texto secreto largo y aleatorio
JWT_SECRET=cambia_esto_por_un_secreto_muy_largo_y_seguro_123!
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=otro_secreto_diferente_para_refresh_456!
JWT_REFRESH_EXPIRES_IN=30d

# ── STRIPE (Pagos) ────────────────────────────────
# Obtenlas en https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── EMAIL (Para recuperar contraseña) ─────────────
# Puedes usar Gmail con una "App Password"
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tucorreo@gmail.com
EMAIL_PASS=tu_app_password_de_gmail
EMAIL_FROM=PhoneX Store <tucorreo@gmail.com>

# ── SEGURIDAD ─────────────────────────────────────
BCRYPT_ROUNDS=12
# URL del frontend (para CORS)
FRONTEND_URL=http://localhost:3000
